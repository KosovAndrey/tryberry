# Запускает tryberry-ci.service раз в 2 минуты (и через 3 мин после загрузки).
# systemd не стартует второй прогон, пока предыдущий (долгая сборка) ещё идёт.
[Unit]
Description=Run TryBerry CI/CD watcher every 2 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
# Если VPS был выключен — догнать пропущенный тик при включении.
Persistent=true

[Install]
WantedBy=timers.target
