# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5433/tryberrybot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=price-tracker

# Публичный базовый URL сайта — для canonical/OG/sitemap страниц графиков цены (/p/).
PUBLIC_BASE_URL=https://tryberry.ru

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.fly.dev/webhook
WEBHOOK_ENABLED=false
# Обязателен при WEBHOOK_ENABLED=true. Генерация: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Публичные ссылки на ботов — для one-click кнопок привязки между каналами
# (пусто = кнопка не показывается, остаётся ручной ввод кода).
TELEGRAM_BOT_URL=https://t.me/TryBerryBot
VK_BOT_URL=https://vk.me/club239474122
# Egress к api.telegram.org идёт через xray (VLESS, сервис xray в compose);
# HTTPS_PROXY у сервисов жёстко = http://xray:8888. TELEGRAM_PROXY_URL больше
# НЕ используется. Конфиг — секрет xray/config.json (см. xray/README.md).
# Длительность long-poll; на стабильном egress можно держать 10с (раньше резало до 1с).
TELEGRAM_POLL_TIMEOUT_SECONDS=10

# Scraper
SCRAPE_INTERVAL_MINUTES=15
SCRAPER_RATE_LIMIT_RPS_WB=5
SCRAPER_RATE_LIMIT_RPS_YANDEX=8
# Я.Маркет — без аккаунта (цена публичная). Ходим direct с датацентр-IP (probe
# держал сотни запросов без капчи — см. docs/YANDEX-WARMED-COOKIES.md). Прокси
# теперь fallback на капчу, не основной путь. Пусто → фолбэк на OZON_PROXY_URL.
# YANDEX_PROXY_URL=http://user:pass@host:port
# Ozon-поиск идёт через сайдкар ozon-miner (browser-пул, /search). Compose задаёт
# OZON_BROWSER_URL по умолчанию (http://ozon-miner:8080); лимит позиций — ниже.
# SEARCH_MAX_ITEMS_OZON=60

# MAX-мессенджер (max.ru). Пусто = канал выключен. Токен — у MasterBot в MAX.
# MAX_CALLBACK_SECRET — любой секрет (openssl rand -hex 32), проверяется в заголовке
# X-Max-Bot-Api-Secret. MAX_WEBHOOK_URL — публичный https вида https://tryberry.ru/max/callback
# (подписка регистрируется на старте api). MAX_ADMIN_IDS — max_id операторов через запятую.
MAX_BOT_TOKEN=
MAX_CALLBACK_SECRET=
MAX_WEBHOOK_URL=
MAX_BOT_URL=
MAX_ADMIN_IDS=

#API
SCRAPER_HEALTH_PORT=8090
NOTIFIER_HEALTH_PORT=8091