# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5433/tryberrybot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=price-tracker

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.fly.dev/webhook
WEBHOOK_ENABLED=false
# Egress к api.telegram.org идёт через WireGuard (сервис wg-proxy + tinyproxy);
# HTTPS_PROXY у сервисов жёстко = http://wg-proxy:8888. TELEGRAM_PROXY_URL больше
# НЕ используется. Конфиг туннеля: wireguard/wg_confs/wg0.conf (см. .example).
# Длительность long-poll; на стабильном WG можно держать 10с (раньше резало до 1с).
TELEGRAM_POLL_TIMEOUT_SECONDS=10

# Scraper
SCRAPE_INTERVAL_MINUTES=15
SCRAPER_RATE_LIMIT_RPS_WB=5
SCRAPER_RATE_LIMIT_RPS_YANDEX=2

#API
SCRAPER_HEALTH_PORT=8090
NOTIFIER_HEALTH_PORT=8091