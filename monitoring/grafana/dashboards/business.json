{
 "uid": "tryberrybot-business",
 "title": "TryBerryBot — Business",
 "tags": [
  "tryberrybot",
  "business"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Активные подписки",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "tryberrybot_active_subscriptions",
     "refId": "A"
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Всего пользователей",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "expr": "tryberrybot_users_total",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "steps": [
       {
        "color": "purple",
        "value": null
       }
      ]
     }
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Уведомлений за 24ч",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(increase(tryberrybot_notifications_sent_total[24h]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Снижений цен за 24ч",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(increase(tryberrybot_price_drops_total[24h]))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "steps": [
       {
        "color": "orange",
        "value": null
       }
      ]
     }
    }
   }
  },
  {
   "id": 5,
   "type": "piechart",
   "title": "Подписки по маркетплейсам",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "expr": "sum(tryberrybot_subscriptions_by_marketplace) by (marketplace)",
     "legendFormat": "{{marketplace}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "values": [
      "value",
      "percent"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Команды /track по результату",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "expr": "sum(rate(tryberrybot_track_commands_total[5m])) by (result)",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Уведомления по маркетплейсам",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "expr": "sum(rate(tryberrybot_notifications_sent_total[5m])) by (marketplace)",
     "legendFormat": "{{marketplace}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Доставка уведомлений по каналам (за час)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (channel, status) (increase(tryberrybot_notifications_delivered_total[1h]))",
     "legendFormat": "{{channel}}: {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "VK-сообщения по типам (за час)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (command) (increase(tryberrybot_vk_messages_total[1h]))",
     "legendFormat": "{{command}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Промокоды и слияния аккаунтов (за сутки)",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "increase(tryberrybot_promo_redeems_total[24h])",
     "legendFormat": "погашений промокодов",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "increase(tryberrybot_account_merges_total[24h])",
     "legendFormat": "слияний аккаунтов",
     "refId": "B"
    }
   ]
  }
 ]
}
