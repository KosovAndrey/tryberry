{
  "uid": "tryberrybot-infra",
  "title": "TryBerryBot — Infrastructure",
  "tags": ["tryberrybot", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Статус сервисов",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"tryberrybot.+|postgres|redis|kafka\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP запросы (RPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(tryberrybot_http_requests_total[1m])) by (path, status)",
          "legendFormat": "{{path}} / {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP латентность p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tryberrybot_http_request_duration_seconds_bucket[5m])) by (path, le))",
          "legendFormat": "p95 {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka — produced/consumed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(tryberrybot_kafka_messages_produced_total[5m])) by (topic)",
          "legendFormat": "produced: {{topic}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(tryberrybot_kafka_messages_consumed_total[5m])) by (topic)",
          "legendFormat": "consumed: {{topic}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (topic, consumergroup)",
          "legendFormat": "{{topic}} / {{consumergroup}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "БД — длительность запросов p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tryberrybot_db_query_duration_seconds_bucket[5m])) by (operation, le))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Go runtime — память",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{service=~\"api|scraper|notifier\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go runtime — горутины",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "go_goroutines{service=~\"api|scraper|notifier\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PostgreSQL — активные подключения",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{datname}} / {{state}}",
          "refId": "A"
        }
      ]
    }
  ]
}