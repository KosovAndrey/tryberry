{
  "//": "ШАБЛОН. Рабочий xray/config.json собирается scripts/xray-config-from-sub.py",
  "//1": "из подписки — руками правят только в аварии. См. xray/README.md.",
  "//2": "Ниже 3 плеча для примера: два tcp+vision и одно grpc. Секреты — плейсхолдеры.",
  "//3": "Теги vless-*: balancer/observatory матчат по префиксу vless → все плечи сразу.",
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "//": "Локальный HTTP-прокси. Сюда ходят api/bot-worker/notifier (HTTPS_PROXY).",
      "tag": "in",
      "listen": "0.0.0.0",
      "port": 8888,
      "protocol": "http",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless-ee10",
      "//": "🇪🇪 Эстония #10 ⚡ 2.0",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "ee10.fi1-cosmostechnology.ru",
            "port": 443,
            "users": [
              {
                "id": "<UUID>",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "qq",
          "serverName": "fi1-cosmostechnology.ru",
          "publicKey": "<REALITY_PUBLIC_KEY>",
          "shortId": "",
          "spiderX": ""
        }
      }
    },
    {
      "tag": "vless-lt1",
      "//": "🇱🇹 Литва #1 ⚡ 2.0",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "lt1.fi1-cosmostechnology.ru",
            "port": 443,
            "users": [
              {
                "id": "<UUID>",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "firefox",
          "serverName": "fi1-cosmostechnology.ru",
          "publicKey": "<REALITY_PUBLIC_KEY>",
          "shortId": "",
          "spiderX": ""
        },
        "grpcSettings": {
          "serviceName": "fi1cosmos",
          "multiMode": false
        }
      }
    },
    {
      "tag": "vless-fl1",
      "//": "🇫🇮 Финляндия #1 ⚡ 2.0",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "fl1.fi1-cosmostechnology.ru",
            "port": 443,
            "users": [
              {
                "id": "<UUID>",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "qq",
          "serverName": "fi1-cosmostechnology.ru",
          "publicKey": "<REALITY_PUBLIC_KEY>",
          "shortId": "",
          "spiderX": ""
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ],
  "observatory": {
    "//": "Пробит все vless-* — живость и пинг до Telegram для балансировщика.",
    "subjectSelector": [
      "vless"
    ],
    "probeUrl": "https://api.telegram.org/",
    "probeInterval": "30s"
  },
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      {
        "//": "leastPing держит трафик на живом и самом быстром плече.",
        "tag": "egress",
        "selector": [
          "vless"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ],
    "rules": [
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "egress"
      }
    ]
  }
}
