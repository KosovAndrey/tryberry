#!/bin/sh
# pre-push — локальный гейт вместо CI.
#
# GitLab CI проекту недоступен: для запуска раннеров нужен верифицированный
# аккаунт (карта), а из РФ это не проходит. Поэтому проверки, которые в норме
# гоняет пайплайн, гоняются здесь — на машине разработчика, перед отправкой.
#
# Ставится:  make hooks-install   (симлинк на этот файл)
# Обход:     git push --no-verify (для доков/промо, когда Go не трогали)
#
# Почему pre-push, а не pre-commit: промежуточные коммиты бывают заведомо
# сломанными, это нормальная работа. А уезжать сломанным в origin — нет.
#
# Почему без «умного» пропуска по изменённым файлам: определить их надёжно во
# всех случаях (новая ветка, force-push, несколько ref в одном push) сложно, а
# хук, который падает из-за собственной логики, обходят и перестают чинить.
# make check — это меньше минуты, дешевле любой хитрости.
set -e

echo "pre-push: make check (обойти: git push --no-verify)"
make check
