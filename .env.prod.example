# ────────────────────────────────────────────────────────────────────────────
# .env.prod.example
#
# Дополнения к существующему .env для production-окружения.
# Скопируй эти строки в свой .env на VM и заполни значения.
# ────────────────────────────────────────────────────────────────────────────

# ── Webhook ─────────────────────────────────────────────────────────────────
# Главный домен и URL для Telegram webhook
WEBHOOK_ENABLED=true
TELEGRAM_WEBHOOK_URL=https://tryberry.ru/webhook
# Секрет аутентификации /webhook. Обязателен при WEBHOOK_ENABLED=true.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# ── Let's Encrypt ───────────────────────────────────────────────────────────
# Сюда LE будет писать предупреждения об истечении сертификата (раз в 60 дней
# точно не приходят, но в случае проблем — придёт уведомление)
CERTBOT_EMAIL=your-email@example.com

# ── Grafana ─────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО смени со значения admin. Минимум 12 символов, без логов наружу.
# Сгенерировать:  openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me-to-something-strong

# ── Ozon ────────────────────────────────────────────────────────────────────
# С 2026-07 Ozon скрейпится DIRECT с датацентр-IP (анонимный camoufox-пул),
# прокси НЕ нужен — переменную оставить пустой. Заполнять только если FAB
# начнёт блокировать датацентр: тогда приватный мобильный со sticky-IP
# (формат http://user:pass@host:port), НЕ shared с ротацией 2 мин — FAB-сессия
# привязана к IP. Тогда же вернутся WB_TOKEN_PROXY_URL/RESELLER_TOKEN_PROXY_URL
# (WB-токены тоже минтятся direct, проверено 2026-07-03).
OZON_PROXY_URL=
# (опц.) id товара Ozon для пост-валидации сессии майнером (лог widgetStates).
OZON_VALIDATE_PRODUCT=

# ────────────────────────────────────────────────────────────────────────────
# Существующие переменные из .env.example — должны быть на месте:
#   DATABASE_URL
#   REDIS_URL
#   KAFKA_BROKERS
#   KAFKA_GROUP_ID
#   TELEGRAM_BOT_TOKEN          ← основной токен бота (у тебя уже есть)
#   TELEGRAM_ALERT_BOT_TOKEN    ← отдельный бот для алертов
#   TELEGRAM_ALERT_CHAT_ID
#   SCRAPE_INTERVAL_MINUTES
#   SCRAPER_RATE_LIMIT_RPS_WB
#   SCRAPER_RATE_LIMIT_RPS_YANDEX
#   SCRAPER_HEALTH_PORT
#   NOTIFIER_HEALTH_PORT
# ────────────────────────────────────────────────────────────────────────────
